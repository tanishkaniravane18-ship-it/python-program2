#ques5
a=100
b=100
print("a=",a ,end=" ")
print("b=",b)
print("id of a:",id(a))
print("id of b:",id(b))
'''a and b stores 100 in the same object and in same memory location so the id is also same for both and hence when the 'is' operator is used it gives the output true as the id is same for a and b'''
print("a is b:",a is b)
print("a is not b:",a is not b)
list1=[10,20,30]
list2=[10,20,30]
print("list1:",list1,end=" ")
print("list2:",list2)
print("id of list1:",id(list1))
print("id of list2:",id(list2))
'''list1 and list2 is stored in different memory location and in different objects so their id is different from each other even when the elements in the list are same and the ans to 'is' operation will be false beacause the operator checks whether the id of both the list is same or not'''
print("list1 is list2:",list1 is list2)
print("list1 is not list2:",list1 is not list2)
print("both list is equal:",list1 == list2)

